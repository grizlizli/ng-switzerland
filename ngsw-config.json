{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/index.csr.html",
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main*.js",
          "/*.css",
          "/icons/**"
        ]
      }
    },
    {
      "name": "javascript",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/**/*.js"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/__*",
    "!/**/__*__/**",
    "!/api/**"
  ]
}
